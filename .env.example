# Copy to .env. Everything is optional: with nothing set, the agent runs on the
# deterministic offline planner and reports land in runs/outbox/.

# Any `provider:model` string accepted by langchain's init_chat_model, e.g.
#   google_genai:<gemini-model>   (needs GOOGLE_API_KEY)
#   openai:<openai-model>         (needs OPENAI_API_KEY)
TRIAGE_MODEL=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Incoming-webhook URL; when empty, reports are written to runs/outbox/ instead.
SLACK_WEBHOOK_URL=
